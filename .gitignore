# Derived output from tools/kicad-verify.py
.build/

# Scratch workspace for the implementation process
.superpowers/

# Python cache
__pycache__/
*.pyc

# macOS Finder junk; not part of this project
.DS_Store

# VS Code Local History extension
.history/

# KiCad per-user project settings; local to each checkout
*.kicad_prl

# Local Claude Code configuration; per-machine, not part of the project
.claude/settings.local.json

# KiCad backups, locks and autosaves; local to a checkout, never project data
*-backups/
*.lck
~*.lck
fp-info-cache
_autosave-*
*.kicad_pcb-bak
*.kicad_sch-bak
*.kicad_pro-bak

# 3D renders are build output: regenerate with tools/render.py, never commit.
# The four in images/ are deliberate and are not covered by this.
verify/renders/
