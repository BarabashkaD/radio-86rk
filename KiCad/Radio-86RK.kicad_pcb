	(gr_text "Monitor Commands - Memory:\nD<Start_Address>,<End_Address> - Display memory content in hexadecimal\nL<Start_Address>,<End_Address> - Display memory content in ASCII\nF<Start_Address>,<End_Address>,<Value> - Fill memory with a value"
		(at 236.5375 131.1275 0)
		(layer "B.SilkS")
		(uuid "00000000-0000-0000-0000-00005e31d498")
		(effects
			(font
				(size 1.5 1.5)
				(thickness 0.2)
			)
			(justify left mirror)
		)
	)
	(gr_text "M<Address> - Modify memory content\nT<Start_Address>,<End_Address>,<Destination_Start_Address> - Copy memory block to destination\nC<Start_Address>,<End_Address>,<Destination_Start_Address> - Compare memory block with destination\nS<Start_Address>,<End_Address>,<Value> - Search memory for a value"
		(at 236.5375 150.1775 0)
		(layer "B.SilkS")
		(uuid "00000000-0000-0000-0000-00005e31dde0")
		(effects
			(font
				(size 1.5 1.5)
				(thickness 0.2)
			)
			(justify left mirror)
		)
	)
	(gr_text "R<ROM_Start_Address>,<ROM_End_Address>,<Destination_Start_Address> - Read from ROM connected to Parallel interface to memory\nMonitor Commands - Run Control and Registers:\nG<Start_Address>[,End_Address] - Run code, optionally stop at the specified address\nX - Display and modify registers"
		(at 236.5375 169.2275 0)
		(layer "B.SilkS")
		(uuid "00000000-0000-0000-0000-00005e31d845")
		(effects
			(font
				(size 1.5 1.5)
				(thickness 0.2)
			)
			(justify left mirror)
		)
	)
	(gr_text "Monitor Commands - Cassette Input/Output:\nO<Start_Address>,<End_Address>[,Speed] - Write memory to cassette. Default speed is 1Dh / 1200 bps\nI[<Offset>][,Speed] - Read data from to cassette memory at specified offset"
		(at 236.5375 186.3725 0)
		(layer "B.SilkS")
		(uuid "00000000-0000-0000-0000-00005e31d726")
		(effects
			(font
				(size 1.5 1.5)
				(thickness 0.2)
			)
			(justify left mirror)
		)
	)
