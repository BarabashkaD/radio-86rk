				(size 1.5 1.5)
				(thickness 0.2)
			)
			(justify left mirror)
		)
	)
	(gr_text "8251A USART\n8275 CRT Controller\nExtension Connector\n8257 DMA Controller (Write Only)\nROM (Read Only)"
