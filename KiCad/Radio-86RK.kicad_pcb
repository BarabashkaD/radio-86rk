	(gr_text "Monitor Subroutines:\n0F803h - Keyboard input - Output: A - character\n0F806h - Cassette input - Input: A=0FFh - with sync\n           A=08h - no sync; Output: A - data"
		(at 72.7075 112.0775 0)
		(layer "B.SilkS")
		(uuid "00000000-0000-0000-0000-00005e31de25")
		(effects
			(font
				(size 1.5 1.5)
				(thickness 0.2)
			)
			(justify left mirror)
		)
	)
	(gr_text "0F809h - Print to screen - Input: C - character\n0F80Ch - Cassette output - Input: C - data\n0F812h - Query keyboard - Output: A=00h - key not\n           pressed; A=0FFh - key pressed"
		(at 72.7075 131.1275 0)
		(layer "B.SilkS")
		(uuid "00000000-0000-0000-0000-00005e31df47")
		(effects
			(font
				(size 1.5 1.5)
				(thickness 0.2)
			)
			(justify left mirror)
		)
	)
	(gr_text "0F815h - Print to screen in hex - Input: A - data\n0F818h - Print string - Input: HL - string address\n0F81Bh - Get key - Output: A=0FFh - key not pressed\n           A=0FEh - Rus/Lat; otherwise A - key code\n"
		(at 72.7075 150.1775 0)
		(layer "B.SilkS")
		(uuid "00000000-0000-0000-0000-00005e31e049")
		(effects
			(font
				(size 1.5 1.5)
				(thickness 0.2)
			)
			(justify left mirror)
		)
	)
	(gr_text "0F81Eh - Get cursor - Output: H - row, L - column\n0F821h - Read screen - Output: A - char at cursor\n0F824h - Read from cassette - Input: HL - offset\n           Output: HL - start; DE - end; BC - chk.sum"
		(at 72.7075 169.2275 0)
		(layer "B.SilkS")
		(uuid "00000000-0000-0000-0000-00005e31e10f")
		(effects
			(font
				(size 1.5 1.5)
				(thickness 0.2)
			)
			(justify left mirror)
		)
	)
	(gr_text "0F82Ah - Calculate checksum - Input: HL - start;\n           DE - end; Output: BC - checksum\n0F82Dh - Initialize CRT (after cassette I/O)\n0F830h/0F833h - Get/Set RAM top - Output/Input: HL\n            - address"
		(at 72.7075 189.5475 0)
		(layer "B.SilkS")
		(uuid "00000000-0000-0000-0000-00005e31e292")
		(effects
			(font
				(size 1.5 1.5)
				(thickness 0.2)
			)
			(justify left mirror)
		)
	)
	(gr_text "RAM (32K); 7600h - 7FFFh: Display and Monitor Memory\n8255A PPI (Keyboard, Cassette, Sound Control)\n8253 PIT (Sound, USART Clock)\n8255A PPI (Parallel Interface)"
		(at 214.3125 96.8375 0)
		(layer "B.SilkS")
		(uuid "281e3cc3-d521-4216-b861-c531651842c0")
		(effects
